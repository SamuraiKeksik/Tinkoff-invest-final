<Window x:Class="TinkoffInvestApp.AuthanticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinkoffInvestApp"
        mc:Ignorable="d"
        Title="AuthanticationWindow" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Image Grid.ColumnSpan="2" Grid.RowSpan="3" Source="/TinkoffLogo.png" Margin="30"/>
        <TextBlock x:Name="ErrorTextBlock" HorizontalAlignment="Center" Grid.Row="2"  Grid.ColumnSpan="2" TextWrapping="Wrap" Text="Ошибка!" VerticalAlignment="Bottom" Foreground="Red" Visibility="Hidden" />
        <TextBox x:Name="TokenTextBox" Grid.ColumnSpan="2" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text="Введите свой токен" VerticalAlignment="Center" Width="500"/>
        <CheckBox x:Name="SandboxCheckBox" Content="Песочница" HorizontalAlignment="Left" Margin="150,58,0,0" Grid.Row="3" VerticalAlignment="Top"/>
        <Button x:Name="StartButton" Content="Продолжить" HorizontalAlignment="Right" Margin="20" Grid.Row="4" VerticalAlignment="Top" Width="100" Click="StartButton_Click"/>
        <Button x:Name="ExitButton" Content="Выйти" HorizontalAlignment="Left" Margin="20" Grid.Row="4" Grid.Column="1" VerticalAlignment="Top" Width="100" Click="ExitButton_Click"/>
        <Grid x:Name="ConnectionStatusGrid" Visibility="Hidden" Grid.ColumnSpan="2" >
            <Rectangle  Height="20"  VerticalAlignment="Top" Fill="#FFFF4549"/>
            <TextBlock Text="Отсутствует связь с Tinkoff Invest, проверьте интернет соединение" HorizontalAlignment="Center" Foreground="White" />
        </Grid>
        
       
    </Grid>
</Window>
